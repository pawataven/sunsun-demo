POSTGRES_USER=sunsun
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sunsun
DATABASE_URL=postgresql://sunsun:change-me@localhost:5432/sunsun
# Integration tests wipe this database; its name must end with _test
TEST_DATABASE_URL=postgresql://sunsun:change-me@localhost:5432/sunsun_test

CSRF_SECRET=generate-with-openssl-rand-base64-32
NUXT_PROMPTPAY_ID=0812345678

# Use a separate EasySlip Branch (and API key) for each environment
NUXT_EASYSLIP_API_KEY=
NUXT_EASYSLIP_DAILY_CAP=200
# Digits only: the bank account registered in EasySlip that NUXT_PROMPTPAY_ID pays into
NUXT_PAYMENT_RECEIVER_BANK_NUMBER=
NUXT_PAYMENT_SLIP_MAX_AGE_HOURS=24
